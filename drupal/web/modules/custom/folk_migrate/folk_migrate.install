<?php

use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Delete unused content types and their nodes.
 */
function folk_migrate_update_10001(): void {
  $types = ['pesnicka', 'profil_blog', 'profil', 'book', 'page', 'simplenews', 'poll'];
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $type_storage = \Drupal::entityTypeManager()->getStorage('node_type');

  foreach ($types as $type) {
    $nids = \Drupal::entityQuery('node')
      ->condition('type', $type)
      ->accessCheck(FALSE)
      ->execute();
    if ($nids) {
      $node_storage->delete($node_storage->loadMultiple($nids));
    }
    $node_type = $type_storage->load($type);
    if ($node_type) {
      $node_type->delete();
    }
  }
}

/**
 * Delete fields field_ucinkujuci, upload, field_profil_kapely.
 */
function folk_migrate_update_10003(): void {
  foreach (['field_ucinkujuci', 'upload', 'field_profil_kapely'] as $field) {
    $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', $field);
    if ($storage) {
      $storage->delete();
    }
  }
}

/**
 * Change field_datumcas from datetime to daterange, restore dates from D6.
 */
function folk_migrate_update_10004(): void {
  \Drupal::service('module_installer')->install(['datetime_range']);

  $db = \Drupal::database();

  // Záloha pred zmazaním (ak tabuľka existuje — t.j. migrácia už bežala)
  $rows = [];
  if ($db->schema()->tableExists('node__field_datumcas')) {
    $rows = $db->select('node__field_datumcas', 'f')->fields('f')->execute()->fetchAll();
  }

  $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_datumcas');
  if ($storage) {
    $storage->delete();
  }

  \Drupal\field\Entity\FieldStorageConfig::create([
    'field_name'  => 'field_datumcas',
    'entity_type' => 'node',
    'type'        => 'daterange',
    'settings'    => ['datetime_type' => 'datetime'],
    'cardinality' => 1,
  ])->save();

  \Drupal\field\Entity\FieldConfig::create([
    'field_name'  => 'field_datumcas',
    'entity_type' => 'node',
    'bundle'      => 'akcia',
    'label'       => 'Dátum a čas',
    'required'    => FALSE,
  ])->save();

  // Ak máme zálohu (migrácia bežala pred týmto hookom), obnov dáta
  if ($rows) {
    foreach ($rows as $row) {
      $val  = $row->field_datumcas_value;
      $data = [
        'bundle'                   => $row->bundle,
        'deleted'                  => $row->deleted,
        'entity_id'                => $row->entity_id,
        'revision_id'              => $row->revision_id,
        'langcode'                 => $row->langcode,
        'delta'                    => $row->delta,
        'field_datumcas_value'     => $val,
        'field_datumcas_end_value' => $val,
      ];
      $db->insert('node__field_datumcas')->fields($data)->execute();
      $db->insert('node_revision__field_datumcas')->fields($data)->execute();
    }
    return;
  }

  // Čistá inštalácia bez migrovaných dát — ak je dostupná D6 DB, načítaj dátumy
  if (!\Drupal\Core\Database\Database::getConnectionInfo('migrate')) {
    return;
  }

  $d6_db   = \Drupal\Core\Database\Database::getConnection('default', 'migrate');
  $d6_rows = $d6_db->query("SELECT nid, field_datumcas_value FROM content_type_akcia WHERE field_datumcas_value IS NOT NULL")->fetchAllKeyed();
  $map     = $db->select('migrate_map_d6_node_complete__akcia', 'm')->fields('m', ['sourceid1', 'destid1'])->execute()->fetchAllKeyed();
  $rev_map = [];
  foreach ($db->select('node_field_data', 'n')->fields('n', ['nid', 'vid', 'langcode'])->condition('type', 'akcia')->execute()->fetchAll() as $r) {
    $rev_map[$r->nid] = ['vid' => $r->vid, 'langcode' => $r->langcode];
  }

  foreach ($d6_rows as $d6_nid => $d6_value) {
    $d11_nid = $map[$d6_nid] ?? NULL;
    if (!$d11_nid || !isset($rev_map[$d11_nid])) continue;
    $value = str_replace(' ', 'T', $d6_value);
    $data  = [
      'bundle'                   => 'akcia',
      'deleted'                  => 0,
      'entity_id'                => $d11_nid,
      'revision_id'              => $rev_map[$d11_nid]['vid'],
      'langcode'                 => $rev_map[$d11_nid]['langcode'],
      'delta'                    => 0,
      'field_datumcas_value'     => $value,
      'field_datumcas_end_value' => $value,
    ];
    $db->insert('node__field_datumcas')->fields($data)->execute();
    $db->insert('node_revision__field_datumcas')->fields($data)->execute();
  }
}

/**
 * Change field_vstupne from decimal to string (text).
 */
function folk_migrate_update_10002(): void {
  $db = \Drupal::database();

  // Záloha existujúcich hodnôt
  $rows = $db->select('node__field_vstupne', 'f')
    ->fields('f', ['entity_id', 'revision_id', 'langcode', 'delta', 'field_vstupne_value'])
    ->execute()
    ->fetchAll();

  // Zmazanie starého decimal field storage (kaskádovo zmaže inštancie + tabuľky)
  $storage = FieldStorageConfig::loadByName('node', 'field_vstupne');
  if ($storage) {
    $storage->delete();
  }

  // Nový string field storage
  FieldStorageConfig::create([
    'field_name'  => 'field_vstupne',
    'entity_type' => 'node',
    'type'        => 'string',
    'settings'    => ['max_length' => 255],
    'cardinality' => 1,
  ])->save();

  // Nová inštancia na bundle akcia
  FieldConfig::create([
    'field_name'  => 'field_vstupne',
    'entity_type' => 'node',
    'bundle'      => 'akcia',
    'label'       => 'Vstupné',
    'required'    => FALSE,
  ])->save();

  // Obnova hodnôt ako text
  foreach ($rows as $row) {
    $val = trim((string) $row->field_vstupne_value);
    if (is_numeric($val)) {
      $val = rtrim(rtrim($val, '0'), '.');
    }
    if ($val === '' || $val === '0') {
      continue;
    }
    $db->insert('node__field_vstupne')->fields([
      'bundle'              => 'akcia',
      'deleted'             => 0,
      'entity_id'           => $row->entity_id,
      'revision_id'         => $row->revision_id,
      'langcode'            => $row->langcode,
      'delta'               => $row->delta,
      'field_vstupne_value' => $val,
    ])->execute();
    $db->insert('node_revision__field_vstupne')->fields([
      'bundle'              => 'akcia',
      'deleted'             => 0,
      'entity_id'           => $row->entity_id,
      'revision_id'         => $row->revision_id,
      'langcode'            => $row->langcode,
      'delta'               => $row->delta,
      'field_vstupne_value' => $val,
    ])->execute();
  }
}
