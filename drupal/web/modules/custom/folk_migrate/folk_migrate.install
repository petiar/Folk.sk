<?php

use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Delete unused content types and their nodes.
 */
function folk_migrate_update_10001(): void {
  $types = ['pesnicka', 'profil_blog', 'profil', 'book', 'page', 'simplenews', 'poll'];
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $type_storage = \Drupal::entityTypeManager()->getStorage('node_type');

  foreach ($types as $type) {
    $nids = \Drupal::entityQuery('node')
      ->condition('type', $type)
      ->accessCheck(FALSE)
      ->execute();
    if ($nids) {
      $node_storage->delete($node_storage->loadMultiple($nids));
    }
    $node_type = $type_storage->load($type);
    if ($node_type) {
      $node_type->delete();
    }
  }
}

/**
 * Change field_vstupne from decimal to string (text).
 */
function folk_migrate_update_10002(): void {
  $db = \Drupal::database();

  // Záloha existujúcich hodnôt
  $rows = $db->select('node__field_vstupne', 'f')
    ->fields('f', ['entity_id', 'revision_id', 'langcode', 'delta', 'field_vstupne_value'])
    ->execute()
    ->fetchAll();

  // Zmazanie starého decimal field storage (kaskádovo zmaže inštancie + tabuľky)
  $storage = FieldStorageConfig::loadByName('node', 'field_vstupne');
  if ($storage) {
    $storage->delete();
  }

  // Nový string field storage
  FieldStorageConfig::create([
    'field_name'  => 'field_vstupne',
    'entity_type' => 'node',
    'type'        => 'string',
    'settings'    => ['max_length' => 255],
    'cardinality' => 1,
  ])->save();

  // Nová inštancia na bundle akcia
  FieldConfig::create([
    'field_name'  => 'field_vstupne',
    'entity_type' => 'node',
    'bundle'      => 'akcia',
    'label'       => 'Vstupné',
    'required'    => FALSE,
  ])->save();

  // Obnova hodnôt ako text
  foreach ($rows as $row) {
    $val = trim((string) $row->field_vstupne_value);
    if (is_numeric($val)) {
      $val = rtrim(rtrim($val, '0'), '.');
    }
    if ($val === '' || $val === '0') {
      continue;
    }
    $db->insert('node__field_vstupne')->fields([
      'bundle'              => 'akcia',
      'deleted'             => 0,
      'entity_id'           => $row->entity_id,
      'revision_id'         => $row->revision_id,
      'langcode'            => $row->langcode,
      'delta'               => $row->delta,
      'field_vstupne_value' => $val,
    ])->execute();
    $db->insert('node_revision__field_vstupne')->fields([
      'bundle'              => 'akcia',
      'deleted'             => 0,
      'entity_id'           => $row->entity_id,
      'revision_id'         => $row->revision_id,
      'langcode'            => $row->langcode,
      'delta'               => $row->delta,
      'field_vstupne_value' => $val,
    ])->execute();
  }
}
