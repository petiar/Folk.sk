{% if page.header or page.primary_menu %}
<nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow">
  <div class="container">

    <a class="navbar-brand" href="{{ path('<front>') }}">folk.sk</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    {% if page.primary_menu %}
      <div class="collapse navbar-collapse" id="mainNav">
        {{ page.primary_menu }}
      </div>
    {% endif %}

  </div>
</nav>
{% endif %}

{% if page.breadcrumb %}
  <div class="bg-light border-bottom py-2">
    <div class="container">{{ page.breadcrumb }}</div>
  </div>
{% endif %}

{% if page.highlighted %}
  <div class="container mt-3">{{ page.highlighted }}</div>
{% endif %}

<main class="container my-5">
  <div class="row">
    <div class="{{ page.sidebar ? 'col-lg-8' : 'col-12' }}">
      {{ page.content }}
    </div>
    {% if page.sidebar %}
      <aside class="col-lg-4">{{ page.sidebar }}</aside>
    {% endif %}
  </div>
</main>

<footer class="py-5 mt-5">
  <div class="container text-center">
    {% if page.footer %}{{ page.footer }}{% endif %}
    <p class="mb-0 small opacity-50">© {{ "now"|date("Y") }} folk.sk</p>
  </div>
</footer>
