{% if page.header or page.primary_menu %}
<header class="navbar bg-primary text-primary-content shadow-lg sticky top-0 z-50">
  <div class="container mx-auto px-4 flex items-center justify-between w-full">

    {# Logo / názov stránky #}
    <div class="navbar-start">
      <a href="{{ path('<front>') }}" class="text-xl font-bold tracking-tight hover:opacity-80 transition-opacity">
        folk.sk
      </a>
    </div>

    {# Hlavná navigácia #}
    {% if page.primary_menu %}
      <nav class="navbar-center hidden lg:flex">
        {{ page.primary_menu }}
      </nav>
    {% endif %}

    {# Mobile menu #}
    <div class="navbar-end lg:hidden">
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="btn btn-ghost btn-circle">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </label>
        <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 text-base-content rounded-box w-52">
          {{ page.primary_menu }}
        </ul>
      </div>
    </div>

  </div>
</header>
{% endif %}

{# Breadcrumb #}
{% if page.breadcrumb %}
  <div class="bg-base-200 border-b border-base-300">
    <div class="container mx-auto px-4 py-2 text-sm">
      {{ page.breadcrumb }}
    </div>
  </div>
{% endif %}

{# Highlighted #}
{% if page.highlighted %}
  <div class="container mx-auto px-4 mt-4">
    {{ page.highlighted }}
  </div>
{% endif %}

{# Hlavný obsah #}
<main class="container mx-auto px-4 py-8">
  <div class="flex gap-8">

    <div class="flex-1 min-w-0">
      {{ page.content }}
    </div>

    {% if page.sidebar %}
      <aside class="w-72 flex-shrink-0">
        <div class="sticky top-24 space-y-6">
          {{ page.sidebar }}
        </div>
      </aside>
    {% endif %}

  </div>
</main>

{# Päta #}
<footer class="footer footer-center p-8 bg-neutral text-neutral-content mt-16">
  <div class="container mx-auto">
    {% if page.footer %}
      {{ page.footer }}
    {% endif %}
    <p class="text-sm opacity-60">© {{ "now"|date("Y") }} folk.sk</p>
  </div>
</footer>
