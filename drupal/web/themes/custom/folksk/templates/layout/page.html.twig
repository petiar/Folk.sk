{# ── Header ────────────────────────────────────────────────────────────────── #}
<header class="site-header">

  {# Logo + slogan — centrované #}
  <div class="container site-header__top">
    <div class="site-name">
      <a href="{{ path('<front>') }}">Folk<span>.</span>sk</a>
    </div>
  </div>

  {% if site_slogan %}
    <div class="site-slogan">{{ site_slogan }}</div>
  {% endif %}

  {# Bootstrap navbar — responzívna navigácia #}
  <nav class="site-nav navbar navbar-expand-lg" aria-label="Hlavná navigácia">
    <div class="container">

      {# Hamburger pre mobilné zariadenia #}
      <button class="navbar-toggler ms-auto"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#folkNavbar"
              aria-controls="folkNavbar"
              aria-expanded="false"
              aria-label="Otvoriť navigáciu">
        <span class="navbar-toggler-icon"></span>
      </button>

      {# Navigačné položky #}
      <div class="collapse navbar-collapse justify-content-center" id="folkNavbar">
        {{ page.primary_menu }}
      </div>

    </div>
  </nav>

</header>

{# ── Highlighted / Flash messages ─────────────────────────────────────────── #}
{% if page.highlighted %}
  <div class="container mt-3">{{ page.highlighted }}</div>
{% endif %}

{# ── Hlavný obsah ─────────────────────────────────────────────────────────── #}
<main class="container">
  <div class="row">

    {# Obsah — 8 stĺpcov #}
    <div class="col-lg-8">
      {{ page.content }}
    </div>

    {# Sidebar — 4 stĺpce #}
    <aside class="col-lg-4 site-sidebar">
      {{ page.sidebar }}
    </aside>

  </div>
</main>

{# ── Päta ────────────────────────────────────────────────────────────────────#}
<footer class="site-footer">
  <div class="container">
    {% if page.footer %}{{ page.footer }}{% endif %}
    <p class="mb-0">© {{ "now"|date("Y") }} folk.sk</p>
  </div>
</footer>
