{# ── Header ────────────────────────────────────────────────────────────────── #}
<header class="site-header">

  {# Horný pruh: vyhľadávanie vpravo #}
  <div class="container site-header__top">
    <div class="site-name">
      <a href="{{ path('<front>') }}">Folk<span>.</span>sk</a>
    </div>
  </div>

  {% if site_slogan %}
    <div class="site-slogan">{{ site_slogan }}</div>
  {% endif %}

  {# Navigácia #}
  {% if page.primary_menu %}
    <nav class="site-nav">
      <div class="container d-flex justify-content-center">
        {{ page.primary_menu }}
      </div>
    </nav>
  {% endif %}

</header>

{# ── Highlighted / Flash messages ─────────────────────────────────────────── #}
{% if page.highlighted %}
  <div class="container mt-3">{{ page.highlighted }}</div>
{% endif %}

{# ── Hlavný obsah ─────────────────────────────────────────────────────────── #}
<main class="container">
  <div class="row">

    {# Obsah — 8 stĺpcov #}
    <div class="col-lg-8">
      {{ page.content }}
    </div>

    {# Sidebar — 4 stĺpce #}
    <aside class="col-lg-4 site-sidebar">
      {{ page.sidebar }}
    </aside>

  </div>
</main>

{# ── Päta ────────────────────────────────────────────────────────────────────#}
<footer class="site-footer">
  <div class="container">
    {% if page.footer %}{{ page.footer }}{% endif %}
    <p class="mb-0">© {{ "now"|date("Y") }} folk.sk</p>
  </div>
</footer>
