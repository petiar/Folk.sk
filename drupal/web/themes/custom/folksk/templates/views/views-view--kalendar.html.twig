{{ attach_library('folksk/global') }}

<div class="view-kalendar">

  {# Nadpis a popis #}
  <div class="view-kalendar__header mb-4">
    {% if display_id == 'page_2' %}
      <a href="/kalendar" class="btn btn-outline-secondary btn-sm mb-3">← Nadchádzajúce akcie</a>
      <h1 class="view-kalendar__title">Archív akcií</h1>
      <p class="text-muted">Kde všade sa hralo</p>
    {% else %}
      <h1 class="view-kalendar__title">Kalendár akcií</h1>
      <p class="text-muted">Prehľad koncertov, festivalov a podujatí</p>
    {% endif %}
  </div>

{# Zoznam udalostí #}
  {% if rows %}
    <div class="view-kalendar__list">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-kalendar__empty text-center py-5 text-muted">
      {{ empty }}
    </div>
  {% endif %}

  {# Pager #}
  {% if pager %}
    <div class="mt-4">{{ pager }}</div>
  {% endif %}

  {# Odkaz na archív — len na stránke nadchádzajúcich akcií #}
  {% if display_id == 'page_1' %}
    <div class="text-center mt-5">
      <a href="/kalendar/archiv" class="btn btn-outline-secondary">Archív minulých akcií →</a>
    </div>
  {% endif %}

</div>
