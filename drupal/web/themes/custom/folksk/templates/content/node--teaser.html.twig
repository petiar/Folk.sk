<article{{ attributes.addClass('card', 'h-100', 'shadow-sm') }}>

  {% if content.field_image %}
    <a href="{{ url }}">{{ content.field_image }}</a>
  {% endif %}

  <div class="card-body d-flex flex-column">

    <div class="mb-2">
      <span class="badge text-bg-primary">{{ node.type.entity.label }}</span>
      <small class="text-muted ms-2">{{ node.createdtime|date('d.m.Y') }}</small>
    </div>

    <h5 class="card-title">
      <a href="{{ url }}" class="text-decoration-none stretched-link">{{ label }}</a>
    </h5>

    {% if content.body %}
      <div class="card-text text-muted small mb-3">{{ content.body }}</div>
    {% endif %}

    <div class="mt-auto d-flex justify-content-between align-items-center">
      <small class="text-muted">{{ 'od'|t }} {{ author_name }}</small>
    </div>

  </div>
</article>
