{
  "name": "folksk-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "sass src/scss/style.scss dist/css/style.css --style=compressed && cp node_modules/bootstrap/dist/js/bootstrap.bundle.min.js dist/js/bootstrap.bundle.min.js",
    "watch": "sass src/scss/style.scss dist/css/style.css --watch"
  },
  "devDependencies": {
    "bootstrap": "^5.3",
    "sass": "^1.77"
  }
}
